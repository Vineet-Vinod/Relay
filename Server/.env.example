# Copy this file to Server/.env and adjust the values for your machine.

RELAY_PUBLIC_URL=https://192.168.1.10:8443
RELAY_TLS_CERT_FILE=./certs/relay-cert.pem
RELAY_TLS_KEY_FILE=./certs/relay-key.pem

# Optional
RELAY_HTTP_ADDR=:8443
RELAY_DATA_FILE=./data/relay-store.json
RELAY_PAIRING_TTL=10m
RELAY_SESSION_TTL=2m
RELAY_CLEANUP_INTERVAL=30s
