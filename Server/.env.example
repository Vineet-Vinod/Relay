# Local HTTP control API bind address.
RELAY_HTTP_ADDR=127.0.0.1:8080

# Logical interface name used by the server for state files.
RELAY_WG_INTERFACE=wg0

# Server VPN address. The implementation currently expects a /24.
RELAY_WG_ADDRESS=10.0.0.1/24

# WireGuard UDP port.
RELAY_WG_LISTEN_PORT=51820

# Keep clients reachable through NAT.
RELAY_PERSISTENT_KEEPALIVE=25

# Optional. Set this for remote access tests.
# Example: RELAY_SERVER_ENDPOINT=vpn.example.com:51820
RELAY_SERVER_ENDPOINT=

# Optional. If empty, the server detects the default-route interface.
# Example: RELAY_EGRESS_INTERFACE=en0
RELAY_EGRESS_INTERFACE=

# Local state directory for keys and transient config artifacts.
RELAY_STATE_DIR=./.state
